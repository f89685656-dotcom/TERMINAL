<Window x:Class="TERMINAL.Windows.DeviceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки приборов"
        Width="500" Height="620" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <!-- Немного увеличил высоту окна (Height="620"), чтобы вкладка Уведомлений помещалась целиком -->

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="DeviceTabs" Grid.Row="0">

            <!-- ═══ Общие ═══ -->
            <TabItem Header="Общие">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="GeneralQ2ViewCheck"
                                      Content="q2view"
                                      VerticalAlignment="Center"/>
                            <TextBox x:Name="GeneralTimerBox"
                                     Width="50" Height="24" FontSize="12"
                                     Text="5" Padding="3,1" Margin="10,0,0,0"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="сек" FontSize="12"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="GeneralAutoExcelCheck"
                                  Content="Автозаполнение макросами Excel"/>
                        <CheckBox x:Name="GeneralTickTimingCheck"
                                  Content="Тактирование"
                                  Margin="0,10,0,0"
                                  ToolTip="Показывать плашку с временем такта в главном окне"/>
                        <CheckBox x:Name="GeneralLogSlowTicksCheck"
                                  Content="Логировать медленные такты"
                                  Margin="0,6,0,0"
                                  ToolTip="Писать в журнал предупреждения о медленных тактах (> 500 мс)"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ ST-351 ═══ -->
            <TabItem Header="ST-351">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="IP-адрес:" FontWeight="Bold"/>
                        <TextBox x:Name="FurnaceIpBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Порт:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="FurnacePortBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Регистр уставки:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="FurnaceSetPointRegBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Регистр текущей температуры:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="FurnaceCurrentTempRegBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Регистр режима:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="FurnaceModeRegBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Допуск стабилизации, °C:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="FurnaceStabilizationToleranceBox" Height="24" Padding="4,2"/>

                        <CheckBox x:Name="AutoStopFurnaceCheck"
                                  Content="Автовыключение после пакета"
                                  Margin="0,15,0,0"
                                  ToolTip="Автовыключение печки (имитация кнопки «Стоп») после завершения всех заданий пакетного режима"/>

                        <CheckBox x:Name="ShowFurnaceCardCheck"
                                  Content="Показывать карточку"
                                  Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ АГК ═══ -->
            <TabItem Header="АГК">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="IP-адрес:" FontWeight="Bold"/>
                        <TextBox x:Name="AgkIpBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Порт:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBox x:Name="AgkPortBox" Height="24" Padding="4,2"/>

                        <TextBlock Text="Таймаут ожидания давления, мин:"
                                   FontWeight="Bold" Margin="0,10,0,0"
                                   ToolTip="Если давление не набралось или не сбросилось за это время — задание прерывается"/>
                        <TextBox x:Name="AgkPressureTimeoutBox" Height="24" Padding="4,2"/>

                        <CheckBox x:Name="ShowAgkCardCheck"
                                  Content="Показывать карточку"
                                  Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ СКТБ ЭлПА ═══ -->
            <TabItem Header="СКТБ ЭлПА">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Скрипт фильтрации:" FontWeight="Bold"/>
                        <ComboBox x:Name="SktbFilterScriptCombo" Height="24">
                            <ComboBoxItem Content="Фильтр_данных_ПДС"/>
                            <ComboBoxItem Content="Фильтр_данных_БИДТ"/>
                            <ComboBoxItem Content="Фильтр_РЧ"/>
                            <ComboBoxItem Content="Filter_for_KOSA_GUI"/>
                        </ComboBox>

                        <TextBlock Text="Источник платины:" FontWeight="Bold" Margin="0,12,0,0"/>
                        <ComboBox x:Name="PlatinumSourceCombo"
                                  Height="24"
                                  SelectionChanged="PlatinumSourceCombo_SelectionChanged">
                            <ComboBoxItem Content="МтК @ TERMEX"/>
                            <ComboBoxItem Content="МИТ 8.03 rev.2 (RS-232)"/>
                            <ComboBoxItem Content="TERCON"/>
                        </ComboBox>

                        <!-- Панель COM-порта: показывается только для МИТ 8.03 -->
                        <StackPanel x:Name="PlatinumComPanel"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="COM-порт:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="PlatinumComPortCombo"
                                      Width="100" Height="24"/>
                        </StackPanel>

                        <StackPanel x:Name="PlatinumMtkCommandPanel" Margin="0,10,0,0">
                            <TextBlock Text="Команда МтК @ TERMEX:" FontWeight="Bold"/>

                            <TextBox x:Name="PlatinumMtkCommandBox"
                                     Height="24" Margin="0,4,0,0"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Padding="4,0"
                                     ToolTip="Например: pass2 meas2? 2  (символы \n\0 добавляются автоматически)"/>

                            <TextBlock Text="Символы \n\0 добавляются автоматически при отправке"
                                       FontSize="11" Foreground="Gray" 
                                       Margin="4,2,0,0"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>

                        <CheckBox x:Name="ReadPlatinumCheck"
                                  Content="Читать платину сейчас"
                                  Margin="0,12,0,0"
                                  ToolTip="Если снято — программа не будет обращаться к Платине"/>

                        <CheckBox x:Name="ShowSktbCardCheck"
                                  Content="Показывать карточку"
                                  Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Уведомления ═══ -->
            <TabItem Header="Уведомления">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- Блок включения и инструкции -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="NotificationsEnabledCheck"
                                      Grid.Column="0"
                                      Content="Включить уведомления"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"/>

                            <Button x:Name="NotificationHelpButton"
                                    Grid.Column="1"
                                    Content="❓ Инструкция"
                                    Padding="10,2"
                                    VerticalAlignment="Center"
                                    Click="NotificationHelpButton_Click"/>
                        </Grid>

                        <TextBlock Text="Способ отправки:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="NotificationMethodCombo" Height="24" SelectedIndex="0" SelectionChanged="NotificationMethodCombo_SelectionChanged">
                            <ComboBoxItem Content="Telegram"/>
                            <ComboBoxItem Content="Email (SMTP)"/>
                            <ComboBoxItem Content="ВКонтакте (VK)"/>
                            <ComboBoxItem Content="SMS (SMSC.ru)"/>
                        </ComboBox>

                        <!-- ═══ Панель 1: Telegram ═══ -->
                        <StackPanel x:Name="TelegramPanel" Margin="0,10,0,0">
                            <TextBlock Text="Telegram Token:" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox x:Name="TelegramTokenBox" Height="24" Padding="4,2" ToolTip="Токен от @BotFather"/>

                            <TextBlock Text="Telegram Chat ID:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="TelegramChatIdBox" Height="24" Padding="4,2" ToolTip="ID вашего чата (можно узнать через getUpdates)"/>
                        </StackPanel>

                        <!-- ═══ Панель 2: Email ═══ -->
                        <StackPanel x:Name="EmailPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="SMTP Сервер (напр. smtp.yandex.ru):" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox x:Name="EmailHostBox" Height="24" Padding="4,2"/>

                            <TextBlock Text="Порт (напр. 587):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="EmailPortBox" Height="24" Padding="4,2" Text="587"/>

                            <TextBlock Text="Логин (ваша почта):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="EmailUserBox" Height="24" Padding="4,2"/>

                            <TextBlock Text="Пароль (или пароль приложения):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <PasswordBox x:Name="EmailPassBox" Height="24" Padding="4,2"/>

                            <TextBlock Text="Кому отправлять (Email):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="EmailToBox" Height="24" Padding="4,2"/>
                        </StackPanel>

                        <!-- ═══ Панель 3: VK ═══ -->
                        <StackPanel x:Name="VkPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Access Token:" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox x:Name="VkTokenBox" Height="24" Padding="4,2" ToolTip="Токен из OAuth ВКонтакте"/>

                            <TextBlock Text="Ваш ID (или ID беседы):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="VkPeerIdBox" Height="24" Padding="4,2" ToolTip="Например: 12345678 (личка) или 2000000001 (беседа)"/>
                        </StackPanel>

                        <!-- ═══ Панель 4: SMS ═══ -->
                        <StackPanel x:Name="SmsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Логин SMSC.ru:" FontWeight="Bold" Margin="0,5,0,5"/>
                            <TextBox x:Name="SmsLoginBox" Height="24" Padding="4,2"/>

                            <TextBlock Text="Пароль SMSC.ru:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <PasswordBox x:Name="SmsPassBox" Height="24" Padding="4,2"/>

                            <TextBlock Text="Номер телефона (напр. +79991234567):" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="SmsPhoneBox" Height="24" Padding="4,2"/>
                        </StackPanel>

                        <Button x:Name="TestNotificationButton" 
                                Content="Отправить тестовое сообщение" 
                                Width="220" Height="30" Margin="0,20,0,0"
                                HorizontalAlignment="Left"
                                Click="TestNotificationButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="По умолчанию" Width="120" Height="30"
                    Click="Default_Click"/>
            <Button Content="Сохранить" Width="100" Height="30" Margin="10,0,0,0"
                    Click="Save_Click"/>
            <Button Content="Отмена" Width="80" Height="30" Margin="10,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>