<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>6.ico</ApplicationIcon>
		<AssemblyName>TERMINAL</AssemblyName>
		<Version>1.5.05</Version>
		<PackageIcon>6.png</PackageIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	
	<ItemGroup>
	  <Content Include="$(NuGetPackageRoot)system.io.ports\8.0.0\runtimes\win\lib\net8.0\System.IO.Ports.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>runtimes\win\lib\net8.0\System.IO.Ports.dll</Link>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<None Remove="Images\AGK.png" />
		<None Remove="Images\ST_351.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="6.ico" />
		<Content Include="Images\AGK.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Images\ST_351.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="TERMINAL.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <None Include="Setup.vdproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HidSharp" Version="2.6.4" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />   <!-- ← 8.0.0 вместо 11.0.0-rc -->
	</ItemGroup>

	<ItemGroup>
		<Page Update="Windows\DeviceSettingsWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

</Project>