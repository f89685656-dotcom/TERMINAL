<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>6.ico</ApplicationIcon>
		<AssemblyName>TERMINAL</AssemblyName>
		<Version>1.6.0</Version>
		<PackageIcon>6.png</PackageIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Images\AGK.png" />
		<None Remove="Images\ST_351.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="6.ico" />
		<Content Include="Images\AGK.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Images\ST_351.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="TERMINAL.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Include="Setup.vdproj" />
	</ItemGroup>

	<!-- NuGet-пакеты -->
	<ItemGroup>
		<PackageReference Include="HidSharp" Version="2.6.4" />
		<PackageReference Include="LibUsbDotNet" Version="2.2.29" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
		<PackageReference Include="System.IO.Ports" Version="11.0.0-rc.3.26522.148" />
	</ItemGroup>

	<!-- Ссылки на проекты (должны быть отдельно от PackageReference!) -->
	<ItemGroup>
		<!-- Путь ..\..\ выходит из папки T.E.R.M.I.N.A.L._code на диск C:\ и заходит в GUI_Merge -->
		<ProjectReference Include="..\..\GUI_Merge\KalibratorGUI\KalibratorGUI_WPF\KalibratorGUI_WPF.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Page Update="Windows\DeviceSettingsWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

	<!-- ★ ПРИНУДИТЕЛЬНО КОПИРУЕМ ПРАВИЛЬНУЮ System.IO.Ports.dll ПОСЛЕ СБОРКИ ★ -->
	<Target Name="CopyIoPortsDll" AfterTargets="Build">
		<ItemGroup>
			<PortsDll Include="$(ProjectDir)runtimes\win\lib\net8.0\System.IO.Ports.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(PortsDll)" DestinationFolder="$(OutputPath)" OverwriteReadOnlyFiles="true" />
	</Target>

</Project>