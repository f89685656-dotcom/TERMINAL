<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>6.ico</ApplicationIcon>
		<AssemblyName>TERMINAL</AssemblyName>
		<Version>1.7.1</Version>
		<PackageIcon>6.png</PackageIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- ★ НАСТРОЙКИ ПУБЛИКАЦИИ В ОТДЕЛЬНУЮ ПАПКУ ★ -->
		<PublishDir>$(MSBuildProjectDirectory)\..\Setup\Publish\</PublishDir>
		<PublishUrl>$(MSBuildProjectDirectory)\..\Setup\Publish\</PublishUrl>

		<!-- ★ SELF-CONTAINED, ЧТОБЫ ВСЕ DLL БЫЛИ РЯДОМ ★ -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Images\AGK.png" />
		<None Remove="Images\ST_351.png" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="FT260_I2CDotNet">
			<HintPath>Libs\FT260_I2CDotNet.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Content Include="6.ico" />
		<Content Include="Images\AGK.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="Images\ST_351.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="TERMINAL.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Include="Setup.vdproj" />
	</ItemGroup>

	<!-- NuGet-пакеты -->
	<ItemGroup>
		<PackageReference Include="HidSharp" Version="2.6.4" />
		<PackageReference Include="LibUsbDotNet" Version="2.2.29" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
	</ItemGroup>

	<!-- Ссылки на проекты -->
	<ItemGroup>
		<ProjectReference Include="..\..\GUI_Merge\KalibratorGUI\KalibratorGUI_WPF\KalibratorGUI_WPF.csproj" />
	</ItemGroup>

	<!-- ★ КОПИРОВАНИЕ БИБЛИОТЕК FT260 В BIN И PUBLISH ★ -->
	<ItemGroup>
		<None Update="Libs\FT260_I2CDotNet.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Libs\libFT260.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Page Update="Windows\DeviceSettingsWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

	<!-- ★ АВТОМАТИЧЕСКОЕ КОПИРОВАНИЕ НАТИВНЫХ DLL В КОРЕНЬ PUBLISH ★ -->
	<Target Name="CopyNativeLibsToPublish" AfterTargets="Publish">
		<ItemGroup>
			<NativeLibs Include="$(PublishDir)runtimes\**\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeLibs)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>