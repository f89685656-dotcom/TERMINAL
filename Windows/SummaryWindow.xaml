<Window x:Class="TERMINAL.Windows.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводка данных"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: путь -->
            <RowDefinition Height="Auto"/>
            <!-- 2: прогресс -->
            <RowDefinition Height="Auto"/>
            <!-- 3: заголовок сводки -->
            <RowDefinition Height="Auto" MaxHeight="260"/>
            <!-- 4: DataGrid сводки → было 2* -->
            <RowDefinition Height="Auto"/>
            <!-- 5: заголовок деталей -->
            <RowDefinition Height="Auto"/>
            <!-- 6: TabControl -->
            <RowDefinition Height="4*"/>
            <!-- 7: область деталей → было 3* -->
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="OpenCsvButton" Content="Открыть CSV"
                    Width="110" Height="28" Margin="0,0,6,0"
                    Click="OpenCsv_Click"/>
            <Button x:Name="SaveCsvButton" Content="Сохранить CSV"
                    Width="120" Height="28" Margin="0,0,6,0"
                    Click="SaveCsv_Click"/>
            <Button x:Name="RefreshButton" Content="Обновить"
                    Width="100" Height="28" Margin="0,0,6,0"
                    Click="Refresh_Click"/>
            <Button x:Name="PrintButton" Content="Печать"
                    Width="100" Height="28" Margin="0,0,6,0"
                    Click="Print_Click"/>

            <CheckBox x:Name="PrintAllCheckBox"
                      Content="Печать всех датчиков"
                      FontSize="12"
                      VerticalAlignment="Center"
                      Margin="15,0,0,0"/>

            <TextBlock x:Name="BatchNameText"
                       Text="Партия: —"
                       VerticalAlignment="Center"
                       FontSize="13" FontWeight="Bold"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <!-- ═══ Путь к папке ═══ -->
        <TextBlock Grid.Row="1"
                   x:Name="DataFolderText"
                   Text=""
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <!-- ═══ Прогресс-бар (отдельная строка) ═══ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <ProgressBar x:Name="LoadProgressBar"
                         Width="300" Height="18"
                         Minimum="0" Maximum="1"
                         Value="0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="LoadProgressText"
                       Text=""
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="Gray"
                       Margin="8,0,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- ═══ Заголовок сводки ═══ -->
        <TextBlock Grid.Row="3"
                   Text="Сводка по датчикам"
                   FontSize="14" FontWeight="Bold"
                   Margin="0,0,0,4"/>

        <!-- ═══ DataGrid сводки ═══ -->
        <DataGrid Grid.Row="4"
                  x:Name="SummaryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="SummaryGrid_SelectionChanged"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                <DataGridTextColumn Header="Опис.град." Binding="{Binding GradDescription, StringFormat=0.0000}" Width="90"/>
                <DataGridTextColumn Header="Пров.1" Binding="{Binding Check1, StringFormat=0.0000}" Width="80"/>
                <DataGridTextColumn Header="Пров.2" Binding="{Binding Check2, StringFormat=0.0000}" Width="80"/>
                <DataGridTextColumn Header="Пров.3" Binding="{Binding Check3, StringFormat=0.0000}" Width="80"/>
                <DataGridTextColumn Header="Пров.4" Binding="{Binding Check4, StringFormat=0.0000}" Width="80"/>
                <DataGridTextColumn Header="Пров.5" Binding="{Binding Check5, StringFormat=0.0000}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Заголовок деталей ═══ -->
        <TextBlock Grid.Row="5"
                   x:Name="DetailHeaderText"
                   Text="Детали: выберите датчик"
                   FontSize="14" FontWeight="Bold"
                   Margin="0,10,0,4"/>

        <!-- ═══ TabControl ═══ -->
        <TabControl Grid.Row="6"
                    x:Name="DetailTabs"
                    SelectionChanged="DetailTabs_SelectionChanged"
                    Height="30"
                    Margin="0,0,0,4">
            <TabItem Header="Гистерезис"/>
            <TabItem Header="ТЧХ"/>
            <TabItem Header="Погрешность"/>
            <TabItem Header="ГСТ"/>
        </TabControl>

        <!-- ═══ Область деталей ═══ -->
        <Border Grid.Row="7"
                BorderBrush="#FFCCCCCC" BorderThickness="1"
                Background="#FFFCFCFC"
                CornerRadius="2">
            <ContentControl x:Name="DetailContent"/>
        </Border>
    </Grid>
</Window>