<Window x:Class="PressureMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pressure Monitor" Height="850" Width="950"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="700"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="StopButton" Content="СТОП"
                            Height="45" Width="120" FontSize="16"
                            Padding="6,4" VerticalContentAlignment="Center"
                            Background="#FFD05050" Foreground="White"
                            FontWeight="Bold" Click="StopButton_Click"/>
                    <Button x:Name="VentButton" Content="СБРОС"
                            Height="45" Width="120" FontSize="16"
                            Padding="6,4" Margin="10,0,0,0"
                            VerticalContentAlignment="Center"
                            Background="#FF5080D0" Foreground="White"
                            FontWeight="Bold" Click="VentButton_Click"/>
                </StackPanel>

                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Текущее давление:" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="PressureText" Text="-" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               x:Name="UnitsText" Text="" FontSize="14"
                               VerticalAlignment="Center" Margin="5,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Уставка:" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="SetPointText" Text="-" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               x:Name="SetPointUnitsText" Text="" FontSize="14"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Таймер:" FontSize="14" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TimerText" Text="00:00:00"
                               FontSize="32" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,5,0,0">
                    <TextBlock x:Name="BroadcastStatusIcon" Text="⛔"
                               FontSize="16" Foreground="Red"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="BroadcastStatusText"
                               Text="Клиентов подключено: 0"
                               FontSize="12" Foreground="Gray"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ROW 1 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Целевое давление:"
                           FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TargetPressureCombo"
                          Width="220" MinWidth="220" Height="32" FontSize="14"
                          Padding="6,4" VerticalAlignment="Top"
                          VerticalContentAlignment="Center"
                          SelectionChanged="TargetPressureCombo_SelectionChanged"/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Набор таймеров:"
                           FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TimerSetCombo"
                          Width="220" MinWidth="220" Height="32" FontSize="14"
                          Padding="6,4" VerticalAlignment="Top"
                          VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Кнопка Старт + поле "Начать с шага" -->
            <StackPanel Grid.Row="2" Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0,0,0,15">
                <Button x:Name="StartButton"
                        Content="Начать градуировку"
                        Height="32" Width="180" FontSize="14"
                        Padding="6,4"
                        VerticalContentAlignment="Center"
                        Click="StartButton_Click"/>
                <TextBlock Text="Начать с шага:"
                           VerticalAlignment="Center"
                           Margin="15,0,5,0" FontSize="14"/>
                <TextBox x:Name="StartStepBox"
                         Width="50" Height="32" FontSize="14"
                         Text="1"
                         Padding="6,4"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,0,15">
                <TextBlock Text="Циклов:" VerticalAlignment="Center"
                           Margin="0,0,5,0" FontSize="14"/>
                <TextBox x:Name="CycleCountBox" Width="50" FontSize="14"
                         Text="10" Margin="0,0,10,0" Height="32"
                         Padding="6,4" HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="CycleCountBox_TextChanged"/>
                <Button x:Name="PumpButton" Content="Жамкать"
                        Height="32" Width="120" FontSize="14"
                        Padding="6,4" VerticalContentAlignment="Center"
                        Click="PumpButton_Click"/>
                <Button x:Name="TestFurnaceButton" Content="Тест: уставка печи"
                        Height="32" Width="160" FontSize="13"
                        Padding="6,4" Margin="10,0,0,0"
                        Background="#FFB0A050" Foreground="White"
                        FontWeight="Bold"
                        VerticalContentAlignment="Center"
                        Click="TestWriteFurnace_Click"/>
            </StackPanel>

            <Border Grid.Row="3" Grid.Column="0"
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="8" MaxHeight="500"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StepsList"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding IndexText}" Width="30" FontSize="14"/>
                                    <TextBlock Text="{Binding ValueText}" Width="120" FontSize="14"/>
                                    <TextBlock Text="{Binding CheckMark}" FontSize="16"
                                               Width="25" Foreground="Green"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="3" Grid.Column="1"
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="8" HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="MaxCheck" Text="☐" FontSize="16"
                                   Width="25" Foreground="Green"/>
                        <TextBlock Text="Максимум:" FontSize="14" Width="90"/>
                        <TextBlock x:Name="MaxValueText" Text="0" FontSize="14"/>
                        <TextBlock x:Name="MaxUnitsText" Text="" FontSize="14"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="MinCheck" Text="☐" FontSize="16"
                                   Width="25" Foreground="Green"/>
                        <TextBlock Text="Минимум:" FontSize="14" Width="90"/>
                        <TextBlock x:Name="MinValueText" Text="0" FontSize="14"/>
                        <TextBlock x:Name="MinUnitsText" Text="" FontSize="14"
                                   Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="CyclesCheck" Text="☐" FontSize="16"
                                   Width="25" Foreground="Green"/>
                        <TextBlock Text="Циклов:" FontSize="14" Width="90"/>
                        <TextBlock x:Name="CyclesText" Text="0 / 10" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: Сохранение данных + Подключённые клиенты -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поле пути + кнопка Сохранить -->
            <Grid Grid.Row="0" HorizontalAlignment="Stretch"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Путь сохранения:"
                           FontSize="14" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1" x:Name="SavePathBox"
                         Height="32" FontSize="12"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         TextChanged="SavePathBox_TextChanged"/>

                <Button Grid.Column="2" x:Name="SaveDataButton"
                        Content="Сохранить данные"
                        Height="32" Width="180" FontSize="14"
                        Padding="6,4" Margin="10,0,0,0"
                        Background="#FF5090D0" Foreground="White"
                        FontWeight="Bold"
                        VerticalContentAlignment="Center"
                        Click="SaveData_Click"/>
            </Grid>

            <!-- Заголовок клиентов -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Подключённые клиенты KalibratorGUI:"
                           FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button x:Name="TakePointBroadcastButton"
                        Content="Снять данные во всех клиентах"
                        Height="28" Width="240" FontSize="13"
                        Padding="6,4" Margin="20,0,0,0"
                        Background="#FF80B080" Foreground="White"
                        FontWeight="Bold"
                        Click="TakePointBroadcast_Click"/>
                <Button x:Name="RemoveOfflineButton"
                        Content="Удалить offline"
                        Height="28" Width="150" FontSize="13"
                        Padding="6,4" Margin="10,0,0,0"
                        Background="#FFD08080" Foreground="White"
                        FontWeight="Bold"
                        Click="RemoveOffline_Click"/>
            </StackPanel>

            <!-- Список клиентов -->
            <Border Grid.Row="2"
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="8" MaxHeight="140"
                    HorizontalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClientsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Отключить"
                                                      Click="DisconnectClient_Click"
                                                      Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <Ellipse Grid.Column="1"
                                             Width="12" Height="12"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 3: статус -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Text="Готов" Foreground="Gray"
                   VerticalAlignment="Bottom"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>