                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="100"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <Ellipse Grid.Column="1" Width="12" Height="12"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}"
                                               FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                    <TextBox Grid.Column="3"
                                             Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="3,1"
                                             VerticalContentAlignment="Center" Margin="0,0,6,0"
                                             ToolTip="Введите произвольное имя клиента"/>

                                    <TextBlock Grid.Column="4" Text="{Binding RoleLabel}"
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="#FF2E6B4A"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                    <TextBlock Grid.Column="5" Text="Кол-во датчиков:"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>

                                    <TextBox Grid.Column="6" Width="40"
                                                 Text="{Binding CaseValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="3,1"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 ToolTip="Количество датчиков в текущей загрузке"/>

                                    <TextBlock Grid.Column="7" Text="{Binding StatusText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="Black" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 3: Статус + версия -->
        <!-- ROW 3: Такт (вся ширина) -->
        <!-- ROW 3: Такт (2 строки) -->
        <Border Grid.Row="3"
                    x:Name="TickTimingPanel"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="0,1,0,0"
                    Padding="0,3,0,3"
                    Margin="0,4,0,0">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="TickTimingText"
                   Text="такт: —"
                   Foreground="#FF808080"
                   FontSize="11"
                   FontFamily="Consolas"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="Суммарное время такта за секунду (без SafeDelay)"/>

                <TextBlock x:Name="TickTimingText2"
                   Text=""
                   Foreground="#FF808080"
                   FontSize="11"
                   FontFamily="Consolas"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

        <!-- ROW 4: Статус + версия -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ShowLogButton" Grid.Column="0" Content="Журнал"
            Style="{StaticResource ActionButtonStyle}"
            Height="22" FontSize="11" Padding="8,2"
            Background="#FF808080" VerticalAlignment="Bottom"
            Margin="0,0,8,0"
            Click="ShowLogButton_Click"/>

            <TextBlock x:Name="StatusText" Grid.Column="1"
               Text="Готов" Foreground="Gray" FontSize="12"
               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="VersionText" Grid.Column="2" Text="v0.0.0"
               Foreground="Gray" FontSize="12" FontWeight="SemiBold"
               VerticalAlignment="Bottom" Margin="10,0,0,0"
               Cursor="Hand" TextDecorations="Underline"
               ToolTip="Показать историю изменений"
               MouseLeftButtonUp="VersionText_MouseLeftButtonUp"/>
        </Grid>
    </Grid>
</Window>