<Window x:Class="TERMINAL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T.E.R.M.I.N.A.L." Height="900" Width="950"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="800" MinHeight="700"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Стиль кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFB0B0B0"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль текста ячейки таблицы -->
        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль текста заголовка шапки -->
        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF505050"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль Border-обёртки ячейки с вертикальной линией справа -->
        <Style x:Key="TableCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <!-- Стиль Border-обёртки заголовка -->
        <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <!-- Короткие единицы -->
        <DataTemplate x:Key="ShortUnitsTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="27"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="27"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding IndexText}"
                               Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueNumber}"
                               Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueUnits}"
                               Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ArrowText}"
                               Style="{StaticResource TableCellTextStyle}"
                               FontSize="15" Foreground="Black"
                               HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding KosaCounterText}"
                               Style="{StaticResource TableCellTextStyle}"
                               Foreground="#FF5050A0"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding TimerText}"
                               Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                    <TextBlock Text="{Binding StatusMark}"
                               Style="{StaticResource TableCellTextStyle}"
                               FontSize="16" Foreground="Green"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Длинные единицы -->
        <DataTemplate x:Key="LongUnitsTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="27"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="27"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding IndexText}"
                               Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueNumber}"
                               Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueUnits}"
                               Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ArrowText}"
                               Style="{StaticResource TableCellTextStyle}"
                               FontSize="15" Foreground="Black"
                               HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding KosaCounterText}"
                               Style="{StaticResource TableCellTextStyle}"
                               Foreground="#FF5050A0"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding TimerText}"
                               Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                    <TextBlock Text="{Binding StatusMark}"
                               Style="{StaticResource TableCellTextStyle}"
                               FontSize="16" Foreground="Green"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: основная рабочая область -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Диапазон давлений -->
            <Grid Grid.Row="0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Диапазон давлений:"
                           FontSize="13" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TargetPressureCombo"
                          Width="220" Height="30" FontSize="13"
                          Padding="6,4" VerticalAlignment="Top"
                          VerticalContentAlignment="Center"
                          SelectionChanged="TargetPressureCombo_SelectionChanged"/>
            </Grid>

            <!-- Набор таймеров -->
            <Grid Grid.Row="1"
                  x:Name="TimerSetPanel"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Набор таймеров:"
                           FontSize="13" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="TimerSetCombo"
                          Width="220" Height="30" FontSize="13"
                          Padding="6,4" VerticalAlignment="Top"
                          VerticalContentAlignment="Center"
                          SelectionChanged="TimerSetCombo_SelectionChanged"/>
            </Grid>

            <!-- Режим + параметр + КОСА + автоСтарт -->
            <Grid Grid.Row="2"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" Grid.Column="0" x:Name="ModeCombo"
                          Width="180" Height="30" FontSize="13"
                          Padding="6,4"
                          VerticalContentAlignment="Center"
                          SelectionChanged="ModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Градуировка" IsSelected="True"/>
                    <ComboBoxItem Content="Жамкать"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ParamLabel"
                           Text="Начать с шага:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="18,0,5,0"/>

                <TextBox Grid.Row="0" Grid.Column="2" x:Name="ParamBox"
                         Width="55" Height="30" FontSize="13"
                         Text="1"
                         Padding="4,2"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="ParamBox_TextChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="КОСА:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="25,0,6,0"/>

                <StackPanel Grid.Row="0" Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="KosaCheckBox"
                              VerticalAlignment="Center"
                              Checked="KosaCheckBox_Changed"
                              Unchecked="KosaCheckBox_Changed"/>
                    <TextBox x:Name="KosaTimerBox"
                             Width="55" Height="26" FontSize="13"
                             Text="25"
                             Padding="4,2"
                             Margin="10,0,4,0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="KosaTimerBox_PreviewTextInput"
                             TextChanged="KosaTimerBox_TextChanged"/>
                    <TextBlock Text="сек"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- строка автоСтарта -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,8,0,0">
                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="автоСтарт"
                              FontSize="13"
                              VerticalAlignment="Center"
                              Checked="AutoStartCheckBox_Changed"
                              Unchecked="AutoStartCheckBox_Changed"/>
                    <TextBlock x:Name="AutoStartInfoText"
                               Text=""
                               FontSize="11"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Кнопки СТАРТ + ПАУЗА -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,10">
                <Button x:Name="StartButton"
                        Content="СТАРТ"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="36" Width="140" FontSize="14"
                        Padding="6,4"
                        Background="#FF5090D0"
                        Click="StartButton_Click"/>
                <Button x:Name="PauseButton"
                        Content="ПАУЗА"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="36" Width="120" FontSize="14"
                        Padding="6,4" Margin="8,0,0,0"
                        Background="#FFB0A050"
                        IsEnabled="False"
                        Click="PauseButton_Click"/>
            </StackPanel>

            <!-- Таблица давлений / Максимум-Минимум -->
            <Grid Grid.Row="4"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <!-- Список шагов -->
                    <StackPanel x:Name="CalibrationPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                        <Border BorderBrush="LightGray" BorderThickness="1"
                                Padding="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="500">
                                <StackPanel>

                                    <!-- Шапка: короткие единицы -->
                                    <Grid x:Name="StepsHeaderShort" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="27"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="27"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="№" Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Давл." Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Ед.изм." Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="←" Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Изм." Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Таймер" Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Border>
                                        <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                                            <TextBlock Text="✓" Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Шапка: длинные единицы -->
                                    <Grid x:Name="StepsHeaderLong" Margin="0,0,0,4"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="27"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="27"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="№" Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Давл." Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Ед.изм." Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="←" Style="{StaticResource TableHeaderTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Изм." Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource TableHeaderBorderStyle}">
                                            <TextBlock Text="Таймер" Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Border>
                                        <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                                            <TextBlock Text="✓" Style="{StaticResource TableHeaderTextStyle}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <ItemsControl x:Name="StepsList"
                                                  HorizontalAlignment="Left">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="StepCounterText"
                                   Text="Шаг: 0/0"
                                   FontSize="13"
                                   Margin="8,5,0,0"/>
                    </StackPanel>

                    <!-- Максимум/Минимум -->
                    <StackPanel x:Name="PumpPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">

                        <Border BorderBrush="LightGray" BorderThickness="1"
                                Padding="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel>

                                <!-- Шапка -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="→" Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Режим" Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Давл." Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Ед.изм." Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderThickness="0" Padding="3,0">
                                        <TextBlock Text="Таймер" Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </Grid>

                                <!-- Максимум -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MaxArrow" Text="  " FontSize="15"
                                                   Foreground="Black" HorizontalAlignment="Left"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock Text="Максимум:" Style="{StaticResource TableCellTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MaxValueText" Text="0"
                                                   Style="{StaticResource TableCellTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MaxUnitsText" Text=""
                                                   Style="{StaticResource TableCellTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderThickness="0" Padding="3,0">
                                        <TextBlock x:Name="MaxTimerText" Text=""
                                                   Style="{StaticResource TableCellTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </Grid>

                                <!-- Минимум -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MinArrow" Text="  " FontSize="15"
                                                   Foreground="Black" HorizontalAlignment="Left"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock Text="Минимум:" Style="{StaticResource TableCellTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MinValueText" Text="0"
                                                   Style="{StaticResource TableCellTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                                        <TextBlock x:Name="MinUnitsText" Text=""
                                                   Style="{StaticResource TableCellTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderThickness="0" Padding="3,0">
                                        <TextBlock x:Name="MinTimerText" Text=""
                                                   Style="{StaticResource TableCellTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CyclesText"
                                   Text="Цикл: 0/0"
                                   FontSize="13"
                                   Margin="8,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Правая колонка: печь ST-351 + АГК + СКТБ ЭлПа -->
        <StackPanel Grid.Row="0"
                    Orientation="Vertical"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="340">

            <!-- Карточка печи ST-351 -->
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Background="#FFF8F8F8"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="FurnaceStatusEllipse"
                                 Width="10" Height="10"
                                 Fill="Red"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <Border Width="40" Height="40"
                                CornerRadius="4"
                                Background="White"
                                BorderBrush="#FFDDDDDD"
                                BorderThickness="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Image Source="/Images/ST_351.png"
                                   Stretch="Uniform"
                                   Margin="2"/>
                        </Border>
                        <TextBlock Text="Печь ST-351"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#FF505050"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border CornerRadius="4"
                            Padding="8,3"
                            Margin="0,0,0,5"
                            Background="#FF2E6B4A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Уставка:"
                                       FontSize="12"
                                       Foreground="#FFCCEEDD"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="FurnaceSetPointBox"
                                     Width="75" Height="24" FontSize="15"
                                     FontWeight="Bold"
                                     Text="25"
                                     Padding="4,1"
                                     Background="Transparent"
                                     BorderBrush="#FF6A9F88"
                                     BorderThickness="1"
                                     Foreground="White"
                                     CaretBrush="White"
                                     HorizontalAlignment="Right"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextChanged="FurnaceSetPointBox_TextChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="°C"
                                       FontSize="12"
                                       Foreground="#FFCCEEDD"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="ReadFurnaceSetPointButton"
                                Content="Читать уставку"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="28" FontSize="11"
                                Padding="4,2"
                                Background="#FF6A9FD8"
                                Click="ReadFurnaceSetPoint_Click"/>
                        <Button Grid.Column="1"
                                x:Name="TestFurnaceButton"
                                Content="Записать уставку"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="28" FontSize="11"
                                Padding="4,2" Margin="5,0,0,0"
                                Background="#FFB0A050"
                                Click="TestWriteFurnace_Click"/>
                    </Grid>

                    <Border CornerRadius="4"
                            Padding="8,5"
                            Margin="0,0,0,6"
                            Background="#FF2E4A6B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Текущая:"
                                       FontSize="12"
                                       Foreground="#FFCCDDEE"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="FurnaceCurrentTempText"
                                       Text="— °C"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="FurnaceRunButton"
                                Content="Запуск"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="28" FontSize="11"
                                Padding="4,2"
                                Background="#FF80B080"
                                Click="FurnaceRun_Click"/>
                        <Button Grid.Column="1"
                                x:Name="FurnaceStopButton"
                                Content="Стоп"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="28" FontSize="11"
                                Padding="4,2" Margin="5,0,0,0"
                                Background="#FFD08080"
                                Click="FurnaceStop_Click"/>
                    </Grid>

                    <TextBlock Text="Время стабилизации температуры:"
                               FontSize="12"
                               Foreground="#FF505050"
                               Margin="0,8,0,2"/>

                    <Border CornerRadius="4"
                            Padding="8,4"
                            Background="#FF3A3A3A">
                        <TextBlock x:Name="StabilizationTimerText"
                                   Text="00:00:00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FF80FF80"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button x:Name="ResetStabilizationTimerButton"
                            Content="Сброс таймера стабилизации"
                            Style="{StaticResource ActionButtonStyle}"
                            Height="28" FontSize="11"
                            Padding="4,2" Margin="0,5,0,0"
                            Background="#FF808080"
                            Click="ResetStabilizationTimer_Click"/>

                    <!-- Следующая уставка ST-351 -->
                    <TextBlock Text="Следующая уставка ST-351:"
                               FontSize="12"
                               Foreground="#FF505050"
                               Margin="0,8,0,2"/>

                    <Border CornerRadius="4"
                            Padding="8,3"
                            Margin="0,0,0,5"
                            Background="#FF4A3A6B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="След.:"
                                       FontSize="12"
                                       Foreground="#FFDDCCEE"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="NextFurnaceSetPointBox"
                                     Width="75" Height="24" FontSize="15"
                                     FontWeight="Bold"
                                     Text=""
                                     Padding="4,1"
                                     Background="Transparent"
                                     BorderBrush="#FF9A7FCE"
                                     BorderThickness="1"
                                     Foreground="White"
                                     CaretBrush="White"
                                     HorizontalAlignment="Right"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextChanged="NextFurnaceSetPointBox_TextChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="°C"
                                       FontSize="12"
                                       Foreground="#FFDDCCEE"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="NextFurnaceSetPointInfo"
                               Text=""
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <Button x:Name="ApplyNextSetPointButton"
                            Content="Применить следующую уставку"
                            Style="{StaticResource ActionButtonStyle}"
                            Height="28" FontSize="11"
                            Padding="4,2" Margin="0,0,0,0"
                            Background="#FF6A4FA0"
                            Click="ApplyNextSetPoint_Click"/>

                    <!-- Пакетный режим по температурам -->
                    <CheckBox x:Name="BatchModeCheckBox"
                              Content="Пакетный режим"
                              FontSize="12" FontWeight="Bold"
                              Foreground="#FF505050"
                              Margin="0,8,0,4"
                              Checked="BatchModeCheckBox_Changed"
                              Unchecked="BatchModeCheckBox_Changed"/>

                    <Border x:Name="BatchPanel"
                            BorderBrush="LightGray" BorderThickness="1"
                            CornerRadius="4"
                            Padding="6"
                            Background="White">
                        <StackPanel>
                            <ScrollViewer MaxHeight="180"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="BatchList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- галочка -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- индекс -->
                                                    <ColumnDefinition Width="42"/>
                                                    <!-- температура -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- °C -->
                                                    <ColumnDefinition Width="42"/>
                                                    <!-- минуты -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- мин -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- статус -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- удалить -->
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,5,0"
                                                          ToolTip="Снять галочку, чтобы пропустить задание"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding IndexText}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0"/>

                                                <TextBox Grid.Column="2"
                                                         Text="{Binding SetPointText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"
                                                         Padding="3,1"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Температура уставки, °C"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="°C"
                                                           FontSize="10"
                                                           Foreground="#FF505050"
                                                           VerticalAlignment="Center"
                                                           Margin="3,0,6,0"/>

                                                <TextBox Grid.Column="4"
                                                         Text="{Binding StabilizationMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="12"
                                                         Padding="3,1"
                                                         HorizontalContentAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Время стабилизации, мин"/>

                                                <TextBlock Grid.Column="5"
                                                           Text="мин"
                                                           FontSize="10"
                                                           Foreground="#FF505050"
                                                           VerticalAlignment="Center"
                                                           Margin="3,0,6,0"/>

                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding StatusText}"
                                                           FontSize="10"
                                                           Foreground="{Binding StatusColor}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,5,0"/>

                                                <Button Grid.Column="7"
                                                        Content="✕"
                                                        FontSize="10"
                                                        Width="20" Height="20"
                                                        Padding="0"
                                                        Background="#FFD08080"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Click="RemoveBatchJob_Click"
                                                        Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="AddBatchJobButton"
                                        Content="+ Добавить"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="24" FontSize="10"
                                        Padding="3,1"
                                        Background="#FF80B080"
                                        Click="AddBatchJob_Click"/>
                                <Button Grid.Column="1"
                                        x:Name="ClearBatchButton"
                                        Content="Очистить"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="24" FontSize="10"
                                        Padding="3,1" Margin="5,0,0,0"
                                        Background="#FFB0A050"
                                        Click="ClearBatch_Click"/>
                            </Grid>

                            <TextBlock x:Name="BatchProgressText"
                                       Text=""
                                       FontSize="10"
                                       Foreground="#FF5050A0"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Карточка АГК -->
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Background="#FFF8F8F8">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="AgkStatusEllipse"
                                 Width="10" Height="10"
                                 Fill="Red"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <Border Width="40" Height="40"
                                CornerRadius="4"
                                Background="White"
                                BorderBrush="#FFDDDDDD"
                                BorderThickness="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Image Source="Images/AGK.png"
                                   Stretch="Uniform"
                                   Margin="2"/>
                        </Border>
                        <TextBlock Text="АГК"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#FF505050"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border CornerRadius="4"
                            Padding="8,5"
                            Margin="0,0,0,5"
                            Background="#FF2E4A6B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Давление:"
                                       FontSize="12"
                                       Foreground="#FFCCDDEE"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="AgkPressureText"
                                       Text="—"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="4"
                            Padding="8,5"
                            Background="#FF2E6B4A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Уставка:"
                                       FontSize="12"
                                       Foreground="#FFCCEEDD"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="AgkSetPointText"
                                       Text="—"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Кнопки СТОП + СБРОС -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="StopButton" Content="СТОП"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="34" FontSize="13"
                                Padding="6,4" Background="#FFD05050"
                                Click="StopButton_Click"/>
                        <Button Grid.Column="1"
                                x:Name="VentButton" Content="СБРОС"
                                Style="{StaticResource ActionButtonStyle}"
                                Height="34" FontSize="13"
                                Padding="6,4" Margin="8,0,0,0"
                                Background="#FF5080D0"
                                Click="VentButton_Click"/>
                    </Grid>

                    <!-- кнопка калибровки штоков -->
                    <Button x:Name="CalibrateStocksButton"
                            Content="Калибровка штоков"
                            Style="{StaticResource ActionButtonStyle}"
                            Height="34" FontSize="13"
                            Padding="6,4" Margin="0,8,0,0"
                            Background="#FF6A4FA0"
                            Click="CalibrateStocksButton_Click"/>

                    <!-- статус АГК (get_status) -->
                    <Border CornerRadius="4"
                            Padding="8,5"
                            Margin="0,8,0,0"
                            Background="#FF2E2E2E">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Статус АГК:"
                                       FontSize="11"
                                       Foreground="#FFAAAAAA"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="AgkStatusTextBox"
                                       Text="—"
                                       FontSize="12"
                                       FontFamily="Consolas"
                                       Foreground="#FF80FF80"
                                       TextWrapping="Wrap"
                                       MaxHeight="80"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Карточка СКТБ ЭлПа -->
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Background="#FFF8F8F8"
                    Margin="0,10,0,0">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="PlatinaStatusEllipse"
                                 Width="10" Height="10"
                                 Fill="Red"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="СКТБ ЭлПа"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#FF505050"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border CornerRadius="4"
                            Padding="8,5"
                            Background="#FF2E4A6B">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Платина:"
                                       FontSize="12"
                                       Foreground="#FFCCDDEE"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="PlatinaTempText"
                                       Text="— °C"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ROW 1: Сохранение + Клиенты -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Путь сохранения:"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,0,3"/>
                <TextBox x:Name="SavePathBox"
                         Height="28" FontSize="12"
                         Padding="6,3"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         TextChanged="SavePathBox_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8">
                <Button x:Name="TakePointBroadcastButton"
                        Content="Снять данные"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="30" Width="150" FontSize="12"
                        Padding="6,4"
                        Background="#FF80B080"
                        Click="TakePointBroadcast_Click"/>
                <Button x:Name="SaveDataButton"
                        Content="Сохранить данные"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="30" Width="160" FontSize="12"
                        Padding="6,4" Margin="8,0,0,0"
                        Background="#FF5090D0"
                        Click="SaveData_Click"/>
                <Button x:Name="ClearDataButton"
                        Content="Очистить данные"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="30" Width="150" FontSize="12"
                        Padding="6,4" Margin="8,0,0,0"
                        Background="#FFB0A050"
                        Click="ClearData_Click"/>
                <Button x:Name="RemoveOfflineButton"
                        Content="Удалить Offline"
                        Style="{StaticResource ActionButtonStyle}"
                        Height="30" Width="140" FontSize="12"
                        Padding="6,4" Margin="8,0,0,0"
                        Background="#FFD08080"
                        Click="RemoveOffline_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="Подключённые клиенты KalibratorGUI:"
                       FontSize="13" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,0,4"/>

            <Border Grid.Row="3"
                    BorderBrush="LightGray" BorderThickness="1"
                    Padding="8" MaxHeight="120"
                    HorizontalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ClientsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Отключить"
                                                      Click="DisconnectClient_Click"
                                                      Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>

                                    <Ellipse Grid.Column="1"
                                             Width="12" Height="12"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayText}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StatusText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="Black"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 2: статус + версия -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Text="Готов" Foreground="Gray"
                       FontSize="12"
                       VerticalAlignment="Bottom"/>
            <TextBlock x:Name="VersionText" Grid.Column="1"
                       Text="v0.0.0"
                       Foreground="Gray"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Bottom"
                       Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>