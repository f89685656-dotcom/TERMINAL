<Window x:Class="TERMINAL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TERMINAL.Converters"
        xmlns:local="clr-namespace:TERMINAL"
        xmlns:models="clr-namespace:TERMINAL.Models"
        Title="T.E.R.M.I.N.A.L."
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:ValueToBrushConverter x:Key="ValueToBrush"/>
        <models:InverseBoolToVisibilityConverter x:Key="BoolToVisibilityInverse"/>

        <!-- Стиль кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFB0B0B0"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили текста таблицы -->
        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF505050"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="TableCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <Style x:Key="TableHeaderBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="3,0"/>
        </Style>

        <!-- Короткие единицы -->
        <DataTemplate x:Key="ShortUnitsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="27"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="27"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding IndexText}" Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueNumber}" Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueUnits}" Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ArrowText}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="Black" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding KosaCounterText}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="#FF5050A0" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                    <TextBlock Text="{Binding StatusMark}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="Green" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Длинные единицы -->
        <DataTemplate x:Key="LongUnitsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="27"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="27"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding IndexText}" Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueNumber}" Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ValueUnits}" Style="{StaticResource TableCellTextStyle}"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding ArrowText}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="Black" HorizontalAlignment="Left"/>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding KosaCounterText}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="#FF5050A0" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource TableCellBorderStyle}">
                    <TextBlock Text="{Binding TimerText}" Style="{StaticResource TableCellTextStyle}"
                               HorizontalAlignment="Right"/>
                </Border>
                <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                    <TextBlock Text="{Binding StatusMark}" Style="{StaticResource TableCellTextStyle}"
                               Foreground="Green" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- 1: путь + кнопки -->
            <RowDefinition Height="Auto"/>
            <!-- 2: клиенты -->
            <RowDefinition Height="Auto"/>
            <!-- 3: ТАКТ (новая строка) -->
            <RowDefinition Height="Auto"/>
            <!-- 4: статус + версия -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════ ROW 0 ═══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- КОЛОНКА 0 -->
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Margin="0,0,8,0">

                <!-- СТАРТ / ПАУЗА / НАСТРОЙКИ -->
                <Grid Margin="0,0,0,6" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="StartButton"
                            Content="СТАРТ (пакет)"
                            Style="{StaticResource ActionButtonStyle}"
                            Height="34" FontSize="13"
                            Padding="4,4"
                            Background="#FF2E8B8B"
                            Click="StartButton_Click"/>

                    <Button Grid.Column="1" x:Name="PauseButton"
                            Content="ПАУЗА"
                            Style="{StaticResource ActionButtonStyle}"
                            Height="34" FontSize="14"
                            Padding="6,4" Margin="8,0,0,0"
                            Background="#FFB0A050"
                            IsEnabled="False"
                            Click="PauseButton_Click"/>

                    <Button Grid.Column="2"
                            x:Name="DeviceSettingsButton"
                            Content="⚙"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="34" Height="34" FontSize="16"
                            Padding="0" Margin="8,0,0,0"
                            Background="#FF607090"
                            ToolTip="Настройки приборов"
                            Click="DeviceSettingsButton_Click"/>
                </Grid>

                <!-- Пакетный режим -->
                <Border BorderBrush="LightGray" BorderThickness="1"
                        CornerRadius="6" Padding="8,6"
                        Background="#FFF8F8F8" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Пакетный режим" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF505050" VerticalAlignment="Center"/>
                            <Border x:Name="KosaBadge" CornerRadius="3" Padding="6,1"
                                    Margin="8,0,0,0" Background="#FFE0A050"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    ToolTip="КОСА включена — 3 съёма на точку">
                                <TextBlock x:Name="KosaBadgeText" Text="КОСА 3×"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text=" — если есть активные задания, СТАРТ запустит пакет"
                                       FontSize="11" Foreground="Gray"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Шапка пакета -->
                        <Grid Margin="0,0,0,5" Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ComboCol"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Строка 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Диапазон:"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="BatchTargetPressureCombo"
                                      Width="120" Height="22" FontSize="11"
                                      Padding="3,1" VerticalContentAlignment="Center"
                                      Margin="0,0,10,5" HorizontalAlignment="Left"
                                      SelectionChanged="BatchTargetPressureCombo_SelectionChanged"/>
                            <StackPanel Grid.Row="0" Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,0,5">
                                <TextBlock Text="Таймеры:" FontSize="11"
                                        VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="BatchTimerSetCombo"
                                      Width="120" Height="22" FontSize="11"
                                      Padding="3,1" VerticalContentAlignment="Center"
                                      SelectionChanged="BatchTimerSetCombo_SelectionChanged"/>
                            </StackPanel>

                            <!-- Строка 2 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Пресет:"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      x:Name="BatchPresetCombo"
                                      Width="120" Height="22" FontSize="11"
                                      Padding="3,1" VerticalContentAlignment="Center"
                                      DisplayMemberPath="DisplayText"
                                      Margin="0,0,10,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Row="1" Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="LoadPresetButton" Content="Загрузить"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="22" FontSize="10" Padding="6,1"
                                        Background="#FF5090D0" Margin="0,0,3,0"
                                        Click="LoadPreset_Click"/>
                                <Button x:Name="SavePresetButton" Content="Сохранить"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="22" FontSize="10" Padding="6,1"
                                        Background="#FF80B080" Margin="0,0,3,0"
                                        Click="SavePreset_Click"/>
                                <Button x:Name="DeletePresetButton" Content="Удалить"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="22" FontSize="10" Padding="6,1"
                                        Background="#FFD08080"
                                        Click="DeletePreset_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Список заданий пакета -->
                        <Border x:Name="BatchPanel"
                                BorderBrush="#FFDDDDDD" BorderThickness="1"
                                CornerRadius="4" Padding="5"
                                Background="White" MinHeight="70"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0" MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="BatchList" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="1.0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- 0 CheckBox -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- 1 IndexText -->
                                                        <ColumnDefinition Width="45"/>
                                                        <!-- 2 SetPoint -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- 3 °C -->
                                                        <ColumnDefinition Width="45"/>
                                                        <!-- 4 Stabilization -->
                                                        <ColumnDefinition Width="30"/>
                                                        <!-- 5 мин -->
                                                        <ColumnDefinition Width="130"/>
                                                        <!-- 6 ComboBox режим -->
                                                        <ColumnDefinition Width="45"/>
                                                        <!-- 7 шаг/цикл -->
                                                        <ColumnDefinition Width="36"/>
                                                        <!-- 8 подпись -->
                                                        <ColumnDefinition Width="90"/>
                                                        <!-- 9 Точка -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- 10 StatusText -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- 11 ✕ -->
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,5,0"
                                                              ToolTip="Снять галочку, чтобы пропустить задание"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding IndexText}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>

                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding SetPointText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="3,1"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding IsEditable}"
                                                             ToolTip="Температура уставки, °C"/>

                                                    <TextBlock Grid.Column="3" Text="°C"
                                                               FontSize="10" Foreground="#FF505050"
                                                               VerticalAlignment="Center" Margin="3,0,5,0"/>

                                                    <TextBox Grid.Column="4"
                                                             Text="{Binding StabilizationMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="3,1"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding IsEditable}"
                                                             ToolTip="Время стабилизации, мин"/>

                                                    <TextBlock Grid.Column="5" Text="мин"
                                                               FontSize="10" Foreground="#FF505050"
                                                               VerticalAlignment="Center" Margin="3,0,5,0"/>

                                                    <ComboBox Grid.Column="6"
                                                              SelectedIndex="{Binding ModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="11" Height="20" Padding="2,0"
                                                              VerticalContentAlignment="Center"
                                                              Margin="0,0,5,0"
                                                              IsEnabled="{Binding IsEditable}"
                                                              ToolTip="Режим">
                                                        <ComboBoxItem Content="Градуировка"/>
                                                        <ComboBoxItem Content="Бароциклирование"/>
                                                    </ComboBox>

                                                    <TextBox Grid.Column="7"
                                                             Text="{Binding StartStepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="3,1"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Visibility="{Binding IsCalibrationMode, Converter={StaticResource BoolToVisibility}}"
                                                             ToolTip="Стартовый шаг градуировки"/>

                                                    <TextBlock Grid.Column="8" Text="шаг"
                                                               FontSize="10" Foreground="#FF505050"
                                                               VerticalAlignment="Center" Margin="3,0,5,0"
                                                               Visibility="{Binding IsCalibrationMode, Converter={StaticResource BoolToVisibility}}"/>

                                                    <TextBox Grid.Column="7"
                                                             Text="{Binding CyclesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="3,1"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding IsEditable}"
                                                             Visibility="{Binding IsCalibrationMode, Converter={StaticResource BoolToVisibilityInverse}}"
                                                             ToolTip="Количество циклов"/>

                                                    <TextBlock Grid.Column="8" Text="цикл"
                                                               FontSize="10" Foreground="#FF505050"
                                                               VerticalAlignment="Center" Margin="3,0,5,0"
                                                               Visibility="{Binding IsCalibrationMode, Converter={StaticResource BoolToVisibilityInverse}}"/>

                                                    <!-- Точка -->
                                                    <StackPanel Grid.Column="9"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,5,0"
                                                                Visibility="{Binding IsCalibrationMode, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Точка:" FontSize="10"
                                                                   Foreground="#FF505050"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,3,0"/>
                                                        <TextBox Text="{Binding CaseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="11" Width="32" Padding="2,1"
                                                                 HorizontalContentAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 IsEnabled="{Binding IsEditable}"
                                                                 ToolTip="Точка: 1..10 или -1..-5"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="10"
                                                               Text="{Binding StatusText}"
                                                               FontSize="10"
                                                               Foreground="{Binding StatusColor}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,5,0"/>

                                                    <Button Grid.Column="11"
                                                            Content="✕" FontSize="10"
                                                            Width="20" Height="20" Padding="0"
                                                            Background="#FFD08080" Foreground="White"
                                                            BorderThickness="0"
                                                            Click="RemoveBatchJob_Click"
                                                            Tag="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="AddBatchJobButton"
                                            Content="+ Добавить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Height="24" FontSize="10" Padding="3,1"
                                            Background="#FF80B080"
                                            Click="AddBatchJob_Click"/>
                                    <Button Grid.Column="1" x:Name="ClearBatchButton"
                                            Content="Очистить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Height="24" FontSize="10" Padding="3,1" Margin="5,0,0,0"
                                            Background="#FFB0A050"
                                            Click="ClearBatch_Click"/>
                                </Grid>

                                <Border x:Name="BatchStatusPanel" Grid.Row="2"
                                        CornerRadius="4" Padding="8,5" Margin="0,5,0,0"
                                        Background="#FFF0F0F0" BorderBrush="#FFDDDDDD"
                                        BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Задание:"
                                                   FontSize="11" Foreground="#FF505050"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" x:Name="BatchCurrentJobText"
                                                   Text="—" FontSize="12" FontWeight="Bold"
                                                   Foreground="#FF2E4A6B" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="Текущая:"
                                                   FontSize="11" Foreground="#FF505050"
                                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        <TextBlock Grid.Column="3" x:Name="BatchCurrentTempText"
                                                   Text="— °C" FontSize="12" FontWeight="Bold"
                                                   Foreground="#FF2E4A6B" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4" Text="Δ:"
                                                   FontSize="11" Foreground="#FF505050"
                                                   VerticalAlignment="Center" Margin="16,0,6,0"/>
                                        <TextBlock Grid.Column="5" x:Name="BatchDeltaText"
                                                   Text="—" FontSize="12" FontWeight="Bold"
                                                   Foreground="Gray" VerticalAlignment="Center"
                                                   MinWidth="70"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="BatchProgressText" Grid.Row="3"
                                           Text="" FontSize="10" Foreground="#FF5050A0"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Таблица давлений -->
                <StackPanel x:Name="CalibrationPanel"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border BorderBrush="LightGray" BorderThickness="1"
                            Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#FFF8F8F8" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                            <StackPanel>

                                <Grid x:Name="StepsHeaderShort" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="27"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="№" Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Давл." Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Ед.изм." Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="←" Style="{StaticResource TableHeaderTextStyle}"/>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Изм." Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource TableHeaderBorderStyle}">
                                        <TextBlock Text="Таймер" Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="6" BorderThickness="0" Padding="3,0">
                                        <TextBlock Text="✓" Style="{StaticResource TableHeaderTextStyle}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid x:Name="StepsHeaderLong" Margin="0,0,0,2" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="27"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TableHeaderBorderStyle}">
