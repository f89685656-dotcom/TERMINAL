<UserControl x:Class="TERMINAL.DeviceHub.PollingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:TERMINAL.DeviceHub"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ★ СТИЛЬ ДЛЯ TreeViewItem (ЧЁРНЫЙ ТРЕУГОЛЬНИК, СКРЫТ У КАНАЛОВ) ★ -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- ★ ЧЁРНЫЙ ТРЕУГОЛЬНИК СЛЕВА ★ -->
                                <ToggleButton x:Name="Expander" 
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Width="16" Height="16"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Path x:Name="Arrow" Fill="Black" Data="M 0 0 L 4 4 L 0 8 Z" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- ★ КОНТЕНТ ★ -->
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="5,0,0,0"/>
                            </Grid>
                            <!-- ★ ДЕТИ (С ОТСТУПОМ 40) ★ -->
                            <ItemsPresenter x:Name="ItemsHost" Margin="40,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- ★ СКРЫВАЕМ ТРЕУГОЛЬНИК, ЕСЛИ НЕТ ДЕТЕЙ (КАНАЛЫ) ★ -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (СВЕРХУ) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <!-- Сканер и Настройки -->
            <Button x:Name="ScanButton" Width="40" Height="30" Margin="0,0,10,0" Click="ScanButton_Click" ToolTip="Поиск">
                <Button.Content>
                    <TextBlock x:Name="ScanButtonIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button.Content>
            </Button>

            <Button x:Name="SettingsButton" Content="Настройки" Width="100" Height="30" Margin="0,0,0,0" 
                    Click="SettingsButton_Click"/>

            <!-- Период опроса -->
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" 
                           Foreground="{DynamicResource TextForeground}"/>
                <Slider x:Name="IntervalSlider" Minimum="0.1" Maximum="10" Value="1" 
                        Width="150" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="IntervalSlider_ValueChanged"/>
                <TextBox x:Name="IntervalTextBox" Text="1.00" Width="50" Margin="10,0,0,0"
                         VerticalAlignment="Center" TextChanged="IntervalTextBox_TextChanged"/>
                <TextBlock Text="с" VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextForeground}"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="20,0,0,0" 
                       Foreground="{DynamicResource TextForeground}" Text="Не настроено"/>
        </StackPanel>

        <!-- ОСНОВНАЯ ЗОНА -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ДЕРЕВО УСТРОЙСТВ -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0" Margin="10">
                <TreeView x:Name="DevicesTree" Background="Transparent" ItemsSource="{Binding Interfaces}">
                    <TreeView.Resources>
                        <!-- 1. Интерфейс -->
                        <HierarchicalDataTemplate DataType="{x:Type local:InterfaceNode}" ItemsSource="{Binding Devices}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextForeground}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- 2. Устройство (привязка к ChannelsView + треугольник справа) -->
                        <HierarchicalDataTemplate DataType="{x:Type local:DeviceNode}" ItemsSource="{Binding ChannelsView}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextForeground}"/>
                                <TextBlock Text="{Binding Address}" Foreground="Gray" Margin="5,0,0,0"/>
                                <!-- ★ ТРЕУГОЛЬНИК СПРАВА (ПЕРЕВЁРНУТЫЙ) ★ -->
                                <ToggleButton IsChecked="{Binding ShowOnlySelected, Mode=TwoWay}" 
                                              Width="16" Height="16" Margin="5,0,0,0" Background="Transparent" BorderThickness="0"
                                              ToolTip="Скрыть/показать неотмеченные каналы">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <!-- ★ СТРЕЛКА ВВЕРХ (по умолчанию, все каналы видны) ★ -->
                                                <Path x:Name="ArrowUp" Fill="Black" Data="M 0 4 L 8 4 L 4 0 Z" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- ★ СТРЕЛКА ВНИЗ (когда неотмеченные скрыты) ★ -->
                                                <Path x:Name="ArrowDown" Fill="Black" Data="M 0 0 L 8 0 L 4 4 Z" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ArrowUp" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ArrowDown" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </HierarchicalDataTemplate>

                        <!-- 3. Канал -->
                        <DataTemplate DataType="{x:Type local:ChannelNode}">
                            <Grid Margin="0,2" Background="Transparent" Focusable="True" MouseLeftButtonDown="ChannelRow_MouseLeftButtonDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}"/>

                                <TextBlock Grid.Column="2" 
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" 
                                           Foreground="{DynamicResource TextForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Value, StringFormat=\{0:F3\}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInt32}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Value, StringFormat=\{0:F0\}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <!-- ★ ГРАФИКИ (ДВЕ ВКЛАДКИ С КНОПКАМИ УПРАВЛЕНИЯ НАД НИМИ) ★ -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Панель с кнопками -->
                    <RowDefinition Height="*"/>
                    <!-- Вкладки -->
                </Grid.RowDefinitions>

                <!-- ПАНЕЛЬ С КНОПКАМИ (ВНЕ ШАБЛОНА) -->
                <!-- ПАНЕЛЬ С КНОПКАМИ (ВНЕ ШАБЛОНА) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F0F0F0" Margin="0,0,0,5">
                    <!-- Кнопка ЗАПИСЬ -->
                    <Button x:Name="RecordButton" Click="RecordButton_Click" ToolTip="Начать/Остановить запись графика" 
            Width="40" Height="40" Margin="0,0,5,0" Background="Transparent" BorderThickness="0">
                        <TextBlock x:Name="RecordIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" 
                   FontSize="20" Foreground="#FF4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Кнопка ОБНОВИТЬ -->
                    <Button x:Name="RefreshHistoryButton" Click="RefreshButton_Click" ToolTip="Обновить графики" 
            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- ★ НОВАЯ КНОПКА ОЧИСТКИ ИСТОРИИ ★ -->
                    <Button x:Name="ClearHistoryButton" Click="ClearHistoryButton_Click" ToolTip="Очистить всю историю" 
            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="5,0,0,0">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFE53935"/>
                    </Button>
                </StackPanel>

                <!-- САМ TABCONTROL -->
                <TabControl Grid.Row="1" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                    <!-- ВКЛАДКА 1: РЕАЛЬНОЕ ВРЕМЯ -->
                    <TabItem Header="Реальное время">
                        <oxy:PlotView x:Name="PlotViewRealTime" Background="{DynamicResource PanelBackground}"/>
                    </TabItem>

                    <!-- ВКЛАДКА 2: ИСТОРИЯ -->
                    <TabItem Header="История">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Скроллбар для прокрутки графиков -->
                            <!-- Внутри TabItem Header="История" -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="5">
                                <ItemsControl x:Name="HistoryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,8" CornerRadius="4" Background="White"
                                                    MouseLeftButtonDown="MiniPlot_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="200"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal" Margin="5" Background="#F0F0F0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0:F3}}" FontWeight="Bold" Foreground="Blue" FontSize="14"/>
                                                        <TextBlock Text="{Binding Unit}" Margin="5,0,0,0" FontSize="14"/>
                                                    </StackPanel>

                                                    <oxy:PlotView Grid.Row="1" Model="{Binding ChartModel}" IsHitTestVisible="False" Background="White"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- ★ ПОЛЗУНОК ВРЕМЕНИ (ВНИЗУ) ★ -->
                            <Grid Grid.Row="1" Margin="10,5,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="От:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>
                                <Slider x:Name="HistoryTimeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" 
                                        ValueChanged="HistoryTimeSlider_ValueChanged" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="2" Text="До:" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="Gray"/>
                                <Slider x:Name="HistoryTimeSliderEnd" Grid.Column="3" Minimum="0" Maximum="100" Value="100" 
                                        ValueChanged="HistoryTimeSliderEnd_ValueChanged"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ★ ЛОГ + ПРОГРЕСС-БАРЫ (ВНИЗУ) ★ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ★ ПРОГРЕСС-БАРЫ (НАД ЛОГОМ) ★ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5,10,5">
                <ProgressBar x:Name="ScanProgressBarRS485" Width="150" Height="15" 
                             Minimum="0" Maximum="10" Value="0" 
                             Foreground="#33adff" Background="#222222"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ScanProgressTextRS485" Text="" VerticalAlignment="Center" 
                           Margin="5,0,20,0" Width="100" Foreground="{DynamicResource TextForeground}"
                           Visibility="Collapsed"/>

                <ProgressBar x:Name="ScanProgressBarI2C" Width="150" Height="15" 
                             Minimum="0" Maximum="10" Value="0" 
                             Foreground="#33adff" Background="#222222"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ScanProgressTextI2C" Text="" VerticalAlignment="Center" 
                           Margin="5,0,0,0" Width="100" Foreground="{DynamicResource TextForeground}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- ЛОГ -->
            <ListView Grid.Row="1" x:Name="LogListView" Margin="10,0,10,10" 
                      Background="{DynamicResource PanelBackground}" 
                      Foreground="{DynamicResource TextForeground}"
                      SelectionMode="Extended">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копировать" Click="CopyLogMenuItem_Click" InputGestureText="Ctrl+C"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.InputBindings>
                    <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy"/>
                </ListView.InputBindings>
                <ListView.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Copy" Executed="CopyLogCommand_Executed"/>
                </ListView.CommandBindings>
            </ListView>
        </Grid>
    </Grid>
</UserControl>