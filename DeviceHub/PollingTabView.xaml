<UserControl x:Class="TERMINAL.DeviceHub.PollingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:TERMINAL.DeviceHub"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ★ Конвертер: 0 -> Collapsed, иначе Visible -->
        <local:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>

        <!-- ★ СТИЛЬ ДЛЯ TreeViewItem -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" 
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Width="16" Height="16"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Path x:Name="Arrow" Fill="Black" Data="M 0 0 L 4 4 L 0 8 Z" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="5,0,0,0"/>
                            </Grid>
                            <ItemsPresenter x:Name="ItemsHost" Margin="40,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ УПРАВЛЕНИЯ (СВЕРХУ) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="ScanButton" Width="40" Height="30" Margin="0,0,10,0" Click="ScanButton_Click" ToolTip="Поиск">
                <Button.Content>
                    <TextBlock x:Name="ScanButtonIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button.Content>
            </Button>

            <Button x:Name="SettingsButton" Content="Настройки" Width="100" Height="30" Margin="0,0,0,0" 
                    Click="SettingsButton_Click"/>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" 
                           Foreground="{DynamicResource TextForeground}"/>
                <Slider x:Name="IntervalSlider" Minimum="0.1" Maximum="30" Value="1" 
                        Width="150" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="IntervalSlider_ValueChanged"/>
                <TextBox x:Name="IntervalTextBox" Text="1.00" Width="50" Margin="10,0,0,0"
                         VerticalAlignment="Center" TextChanged="IntervalTextBox_TextChanged"/>
                <TextBlock Text="с" VerticalAlignment="Center" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextForeground}"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="20,0,0,0" 
                       Foreground="{DynamicResource TextForeground}" Text="Не настроено"/>
        </StackPanel>

        <!-- ОСНОВНАЯ ЗОНА -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ДЕРЕВО УСТРОЙСТВ -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Основные устройства (RS-485, I2C и т.д.) -->
                    <TreeView x:Name="DevicesTree" Grid.Row="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              FontFamily="Segoe UI" FontSize="12"
                              ItemsSource="{Binding Interfaces}">

                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть редактор скриптов" Click="OpenScriptEditorMenuItem_Click"/>
                                <MenuItem Header="Загрузить и выполнить скрипт..." Click="LoadScriptMenuItem_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.Resources>
                            <!-- 1. Интерфейс -->
                            <HierarchicalDataTemplate DataType="{x:Type local:InterfaceNode}" ItemsSource="{Binding Devices}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextForeground}" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- 2. Устройство -->
                            <HierarchicalDataTemplate DataType="{x:Type local:DeviceNode}" ItemsSource="{Binding ChannelsView}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextForeground}" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Address, StringFormat='адрес: {0}'}" Foreground="Gray" Margin="5,0,0,0" FontFamily="Segoe UI" FontSize="12"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- 3. Канал -->
                            <DataTemplate DataType="{x:Type local:ChannelNode}">
                                <Grid x:Name="ChannelGrid" Margin="0,1" Background="Transparent" Focusable="True" MouseLeftButtonDown="ChannelRow_MouseLeftButtonDown">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" FontFamily="Segoe UI"/>

                                    <TextBlock Grid.Column="2" 
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" 
                                               Foreground="{DynamicResource TextForeground}" FontFamily="Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Value, StringFormat=\{0:F3\}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInt32}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Value, StringFormat=\{0:F0\}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsVisibleOnPlot}" Value="True">
                                        <Setter TargetName="ChannelGrid" Property="Background" Value="#E0F7FA"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                        <Setter TargetName="ChannelGrid" Property="Background" Value="#FFF9C4"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- 2. Вычисляемые выражения (скрипты) -->
                    <!-- ★ Заменили StackPanel на Grid -->
                    <Grid Grid.Row="1"
      Visibility="{Binding ScriptNodes.Count, Converter={StaticResource ZeroToCollapsedConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок с каскадной галочкой -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,8,0,2">
                            <CheckBox x:Name="AllScriptsCheckBox" 
                  IsChecked="True"
                  Click="AllScriptsCheckBox_Click"
                  VerticalAlignment="Center"
                  Margin="0,0,5,0"/>
                            <TextBlock Text="Вычисляемые выражения"
                   FontWeight="Bold" FontSize="12"
                   Foreground="{DynamicResource TextForeground}"
                   FontFamily="Segoe UI"/>
                        </StackPanel>

                        <TreeView x:Name="ScriptsTree" Grid.Row="1"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              HorizontalContentAlignment="Stretch"
              FontFamily="Segoe UI" FontSize="12"
              ItemsSource="{Binding ScriptNodes}">

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <!-- ★ Важно -->
                                    <EventSetter Event="MouseDoubleClick" Handler="ScriptTreeItem_MouseDoubleClick"/>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.Resources>
                                <DataTemplate DataType="{x:Type local:ScriptNode}">
                                    <!-- ★ Привязываем ширину Grid к ширине самого TreeView, чтобы колонка * работала -->
                                    <Grid x:Name="ScriptGrid" Margin="0,1" Background="Transparent" 
                      Focusable="True" MouseLeftButtonDown="ScriptRow_MouseLeftButtonDown"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}}"
                      ToolTip="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForeground}"
                               FontFamily="Segoe UI"
                               TextTrimming="CharacterEllipsis" 
                               TextWrapping="NoWrap"/>

                                        <TextBlock Grid.Column="2"
                               Text="{Binding DisplayValue}"
                               FontWeight="Bold"
                               Foreground="#FF2196F3"
                               Margin="10,0,10,0" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"/>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsVisibleOnPlot}" Value="True">
                                            <Setter TargetName="ScriptGrid" Property="Background" Value="#E0F7FA"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>

            <!-- ★ ГРАФИКИ ★ -->
            <Grid Grid.Column="1" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F0F0F0" Margin="0,0,0,2">
                    <Button x:Name="RecordButton" Click="RecordButton_Click" ToolTip="Начать/Остановить запись графика" 
                            Width="40" Height="40" Margin="0,0,5,0" Background="Transparent" BorderThickness="0">
                        <TextBlock x:Name="RecordIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" 
                                   FontSize="20" Foreground="#FF4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Grid Width="40" Height="40" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="CsvPathButton" Grid.Row="0" Background="Transparent" BorderThickness="0" 
                                Click="CsvPathButton_Click" Cursor="Hand" ToolTip="Выбрать путь для сохранения CSV">
                            <Border x:Name="CsvPathBorder" BorderBrush="Gray" BorderThickness="1" Width="16" Height="12" Background="#E0E0E0" CornerRadius="2">
                                <TextBlock x:Name="CsvPathText" Text="" FontSize="10" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                            </Border>
                        </Button>
                        <Button x:Name="CsvRecordButton" Grid.Row="1" Click="CsvRecordButton_Click" ToolTip="Начать/Остановить запись в CSV" 
                                Background="Transparent" BorderThickness="0">
                            <TextBlock x:Name="CsvRecordIcon" Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Width="40" Height="40" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="CsvWidePathButton" Grid.Row="0" Background="Transparent" BorderThickness="0" 
                                Click="CsvWidePathButton_Click" Cursor="Hand" ToolTip="Выбрать путь для сохранения широкой таблицы">
                            <Border x:Name="CsvWidePathBorder" BorderBrush="Gray" BorderThickness="1" Width="16" Height="12" Background="#E0E0E0" CornerRadius="2">
                                <TextBlock x:Name="CsvWidePathText" Text="" FontSize="10" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                            </Border>
                        </Button>
                        <Button x:Name="CsvWideRecordButton" Grid.Row="1" Click="CsvWideRecordButton_Click" ToolTip="Начать/Остановить запись широкой таблицы" 
                                Background="Transparent" BorderThickness="0">
                            <TextBlock x:Name="CsvWideRecordIcon" Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" 
                                       FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Button x:Name="RefreshHistoryButton" Click="RefreshButton_Click" ToolTip="Обновить графики" 
                            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="SaveHistoryRowsButton" Click="SaveHistoryRowsButton_Click" ToolTip="Сохранить историю (построчно)" 
                            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="5,0,0,0">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF2196F3"/>
                    </Button>

                    <Button x:Name="SaveHistoryWideButton" Click="SaveHistoryWideButton_Click" ToolTip="Сохранить историю (широкая таблица)" 
                            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="5,0,0,0">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF00BCD4"/>
                    </Button>

                    <Button x:Name="ClearHistoryButton" Click="ClearHistoryButton_Click" ToolTip="Очистить всю историю" 
                            Width="40" Height="40" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="5,0,0,0">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFE53935"/>
                    </Button>
                </StackPanel>

                <TabControl Grid.Row="1" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem Header="Реальное время">
                        <oxy:PlotView x:Name="PlotViewRealTime" Background="{DynamicResource PanelBackground}"/>
                    </TabItem>
                    <TabItem Header="История">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="2">
                                <ItemsControl x:Name="HistoryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="HistoryCard" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,5" CornerRadius="4"
                                                    MouseLeftButtonDown="MiniPlot_MouseLeftButtonDown"
                                                    MouseEnter="HistoryCard_MouseEnter" MouseLeave="HistoryCard_MouseLeave">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="180"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal" Margin="5" Background="#F0F0F0">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Value, StringFormat={}{0:F3}}" FontWeight="Bold" Foreground="Blue" FontSize="12"/>
                                                        <TextBlock Text="{Binding Unit}" Margin="5,0,0,0" FontSize="12"/>
                                                    </StackPanel>
                                                    <oxy:PlotView Grid.Row="1" Model="{Binding ChartModel}" IsHitTestVisible="False" Background="White"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Grid Grid.Row="1" Margin="10,5,10,10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HistoryStartText" Grid.Column="0" Text="С: --:--:--" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="Gray"/>
                                <Grid Grid.Column="1" Height="30">
                                    <Slider x:Name="HistoryEndSlider" Minimum="0" Maximum="100" ValueChanged="HistoryEndSlider_ValueChanged" IsSnapToTickEnabled="False" TickPlacement="None" Background="LightGray" Panel.ZIndex="1">
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                    <Border Height="4" Background="#E0E0E0" CornerRadius="2" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                            <Thumb Width="12" Height="20" Background="#888" BorderBrush="#555" BorderThickness="1" Cursor="Hand">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                    <Slider x:Name="HistoryStartSlider" Minimum="0" Maximum="100" ValueChanged="HistoryStartSlider_ValueChanged" IsSnapToTickEnabled="False" TickPlacement="None" Background="Transparent" Panel.ZIndex="2">
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                    <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                            <Thumb Width="12" Height="20" Background="#00BCD4" BorderBrush="#00838F" BorderThickness="1" Cursor="Hand">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                </Grid>
                                <TextBlock x:Name="HistoryEndText" Grid.Column="2" Text="По: --:--:--" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="Gray"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ЛОГ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ItemsControl x:Name="ScanProgressList" Grid.Row="0" Margin="10,5,10,5" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PortName}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                            <ProgressBar Grid.Column="1" Height="15" Minimum="0" Maximum="{Binding Total}" Value="{Binding Current}" Margin="5,0" Foreground="#33adff" Background="#222222"/>
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="5,0" FontSize="11"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListView Grid.Row="1" x:Name="LogListView" Margin="10,0,10,10" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextForeground}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копировать" Click="CopyLogMenuItem_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>
    </Grid>
</UserControl>