<Window x:Class="TERMINAL.DeviceHub.HubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка интерфейсов" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите активные интерфейсы:" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource TextForeground}"/>

        <StackPanel Grid.Row="1">
            <!-- RS-485 -->
            <GroupBox Header="RS-485 (Modbus)" Margin="0,0,0,15" Foreground="{DynamicResource TextForeground}" BorderBrush="{DynamicResource PanelBorder}">
                <StackPanel Margin="5">
                    <CheckBox x:Name="Rs485CheckBox" Content="Включить RS-485" IsChecked="True" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForeground}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Порт:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextForeground}"/>
                        <ComboBox x:Name="Rs485PortComboBox" Width="120" Margin="0,0,20,0"/>

                        <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextForeground}"/>
                        <ComboBox x:Name="Rs485BaudComboBox" Width="100" SelectionChanged="Rs485BaudComboBox_SelectionChanged">
                            <ComboBoxItem Content="9600"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="57600" IsSelected="True"/>
                            <ComboBoxItem Content="115200"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- I2C -->
            <GroupBox Header="I2C (FT260)" Margin="0,0,0,15" Foreground="{DynamicResource TextForeground}" BorderBrush="{DynamicResource PanelBorder}">
                <StackPanel Margin="5">
                    <CheckBox x:Name="I2CCheckBox" Content="Включить I2C" IsChecked="True" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextForeground}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Переходник:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextForeground}"/>
                        <ComboBox x:Name="I2CAdapterComboBox" Width="250"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="90" Height="30" Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="Отмена" Width="90" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>